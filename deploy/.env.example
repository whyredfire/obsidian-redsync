# A Cloudflare R2 bucket and an API token limited to it (Object Read & Write).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=redsync
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: the local port your reverse proxy forwards to (default 8080), and limits.
# REDSYNC_PORT=8080
# REDSYNC_IMAGE=ghcr.io/whyredfire/obsidian-redsync   # the server image, e.g. from a fork
# REDSYNC_VERSION=2.0.0   # pin the server image; default latest
# REDSYNC_CACHE_MAX=2GB
# REDSYNC_MAX_FILE=200MB
# REDSYNC_SNAPSHOT_HOURS=6
